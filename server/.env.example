# Server Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gemini AI
GEMINI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
