# ─── AI Interviewer Backend — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Server Port
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Google Gemini API Key (get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (for future voice chunk — not yet active)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Client origin for CORS (your React dev server URL)
CLIENT_URL=http://localhost:3000
